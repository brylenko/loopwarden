{
  "name": "loopwarden",
  "version": "1.2.2",
  "description": "Native Node.js event-loop lag monitoring with percentile histograms, debounced two-level alerts, worker_thread support, and pluggable exporters (Prometheus, Sentry, OpenTelemetry).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "require": "./dist/worker.cjs"
    },
    "./prometheus": {
      "types": "./dist/reactors/prometheus.d.ts",
      "import": "./dist/reactors/prometheus.js",
      "require": "./dist/reactors/prometheus.cjs"
    },
    "./sentry": {
      "types": "./dist/reactors/sentry.d.ts",
      "import": "./dist/reactors/sentry.js",
      "require": "./dist/reactors/sentry.cjs"
    },
    "./otel": {
      "types": "./dist/reactors/otel.d.ts",
      "import": "./dist/reactors/otel.js",
      "require": "./dist/reactors/otel.cjs"
    },
    "./pino": {
      "types": "./dist/reactors/pino.d.ts",
      "import": "./dist/reactors/pino.js",
      "require": "./dist/reactors/pino.cjs"
    },
    "./express": {
      "types": "./dist/integrations/express.d.ts",
      "import": "./dist/integrations/express.js",
      "require": "./dist/integrations/express.cjs"
    },
    "./fastify": {
      "types": "./dist/integrations/fastify.d.ts",
      "import": "./dist/integrations/fastify.js",
      "require": "./dist/integrations/fastify.cjs"
    },
    "./nestjs": {
      "types": "./dist/integrations/nestjs.d.ts",
      "import": "./dist/integrations/nestjs.js",
      "require": "./dist/integrations/nestjs.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "event-loop",
    "event-loop-lag",
    "performance",
    "monitoring",
    "prometheus",
    "sentry",
    "opentelemetry",
    "pino",
    "worker-threads"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10",
    "@opentelemetry/api": "^1",
    "@sentry/node": "^8 || ^9 || ^10",
    "express": ">=4",
    "fastify": ">=4",
    "pino": "^9 || ^10",
    "prom-client": "^15"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "prom-client": {
      "optional": true
    },
    "@sentry/node": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "pino": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@sentry/node": "^10.70.0",
    "@types/express": "^5.0.6",
    "@types/node": "^18.19.130",
    "knip": "^6.32.2",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node --test dist-test/",
    "pretest": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build"
  }
}
